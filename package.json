{
  "name": "aether-monorepo",
  "private": true,
  "workspaces": [
    "sdks/typescript",
    "packages/ui",
    "apps/explorer",
    "apps/wallet"
  ],
  "scripts": {
    "build:sdk": "npm run build --prefix sdks/typescript",
    "build:web": "npm run build --workspaces --if-present",
    "dev:explorer": "npm run dev --workspace @aether/explorer",
    "dev:wallet": "npm run dev --workspace @aether/wallet",
    "e2e:client": "npm run build:sdk && node scripts/client-e2e.mjs"
  },
  "devDependencies": {
    "vite": "^8.3.4"
  }
}
