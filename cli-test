#!/usr/bin/env bash
# End-to-end journeys only. Static checks and benchmarks have separate commands.
set -euo pipefail
ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"
case "${1:-}" in
  --help|-h)
    echo "Usage: ./cli-test [--in-process-only]"
    echo "Runs multi-node and agent-settlement E2E, then the four-process devnet journey."
    exit 0 ;;
  ""|--in-process-only) ;;
  *) echo "Unknown option: $1" >&2; exit 2 ;;
esac
[[ $# -le 1 ]] || { echo "Too many arguments" >&2; exit 2; }
cargo test -p aether-node --test e2e_multi_validator --test e2e_byzantine_network --test e2e_adversarial
cargo test -p aether-sdk --test agent_settlement_e2e
if [[ "${1:-}" != --in-process-only ]]; then
  ./scripts/e2e-devnet.sh
fi
